     """
     try:
-        physical = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
+        physical = _physical_memory_bytes()
     except (AttributeError, OSError, ValueError):
         physical = 8 << 30
